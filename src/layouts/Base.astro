---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ActionBar from '@/components/ActionBar.astro';
import Analytics from '@/components/Analytics.astro';
import { site } from '@/data/site';
import { restaurantSchema } from '@/lib/schema';
import displayFont from '@fontsource/cormorant/files/cormorant-latin-300-normal.woff2?url';
import bodyFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  schema?: object[];
  noindex?: boolean;
  /** Pages whose first section is a full-bleed image get a transparent header. */
  overlayHeader?: boolean;
}

const {
  title,
  description,
  image = '/og-logo.png',
  imageAlt = 'Meat Moot Seattle logo',
  type = 'website',
  schema = [],
  noindex = false,
  overlayHeader = false,
} = Astro.props;

const canonicalPath = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/(^|\/)index$/, '$1')
  .replace(/(.)\/$/, '$1');
const canonical = new URL(canonicalPath, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const ogIsLogo = image === '/og-logo.png';
const jsonLd = [restaurantSchema(), ...schema];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogIsLogo && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="geo.region" content="US-WA" />
    <meta name="geo.placename" content="Seattle" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <meta name="theme-color" content="#0b0b0c" />
    <!-- Google Search needs a square icon whose size is a multiple of 48px. Absolute URLs so www and apex resolve the same file. -->
    <link rel="icon" href={new URL('/favicon.ico', site.url).toString()} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href={new URL('/favicon-48.png', site.url).toString()} />
    <link rel="icon" type="image/png" sizes="96x96" href={new URL('/favicon-96.png', site.url).toString()} />
    <link rel="apple-touch-icon" sizes="180x180" href={new URL('/apple-touch-icon.png', site.url).toString()} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <Analytics />
  </head>
  <body class:list={[{ 'has-overlay-header': overlayHeader }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar />

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      document.addEventListener('click', (ev) => {
        const el = (ev.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (!el) return;
        const w = window as unknown as { gtag?: (...a: unknown[]) => void };
        w.gtag?.('event', el.dataset.track, {
          link_url: (el as HTMLAnchorElement).href ?? undefined,
          placement: el.dataset.placement ?? undefined,
          package_name: el.dataset.package ?? undefined,
        });
      });
    </script>
  </body>
</html>
