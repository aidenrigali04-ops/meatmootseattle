---
import { site, formatTime } from '@/data/site';
import { lunchSpecial } from '@/data/menu';

interface Props {
  id?: string;
  variant?: 'reservation' | 'event';
  title?: string;
  intro?: string;
  headingLevel?: 'h1' | 'h2';
}

const {
  id = 'reserve',
  variant = 'reservation',
  title = variant === 'event' ? 'Plan your event' : 'Secure your table',
  intro = variant === 'event'
    ? "Tell us about your group and we'll come back with cuts, quantities and timing within one business day."
    : 'Choose a date, time and party size to book your table online. Walk-ins are welcome when the room allows.',
  headingLevel = 'h2',
} = Astro.props;
const Heading = headingLevel;
const reveal = headingLevel === 'h1' ? {} : { 'data-reveal': true };

const { widgetScript, bookingUrl, largePartySize, formEndpoint, provider } = site.reservations;
const h = site.hours[0];

const times: string[] = [];
for (let m = 11 * 60; m <= 20 * 60 + 30; m += 30) {
  const hr = Math.floor(m / 60);
  const mm = m % 60;
  times.push(`${hr % 12 === 0 ? 12 : hr % 12}:${String(mm).padStart(2, '0')} ${hr >= 12 ? 'PM' : 'AM'}`);
}
const guestOptions = ['6–7', '8–12', '13–20', '21–40', '40+'];
const subject = 'Event / large party enquiry';
const largeMail = `mailto:${site.email}?subject=${encodeURIComponent(`Large party request (${largePartySize}+ guests)`)}`;
---

<section class="section reserve" id={id} aria-labelledby={`${id}-title`}>
  <div class="container grid">
    <div class="intro">
      <p class="eyebrow eyebrow--gold" {...reveal}>{variant === 'event' ? 'Enquiries' : 'Reservations'}</p>
      <Heading id={`${id}-title`} class="h2" {...reveal} style="--reveal-i:1">{title}</Heading>
      <p class="body-muted" {...reveal} style="--reveal-i:2">{intro}</p>
      <p class="call" {...reveal} style="--reveal-i:3">
        Prefer to talk? <a href={`tel:${site.phoneE164}`} data-track="click_call" data-placement={`${variant}_section`}>{site.phone}</a>
      </p>
    </div>

    {
      variant === 'reservation' ? (
        <div class="booking" {...reveal} style="--reveal-i:2">
          <ul class="facts">
            <li>
              <span>Hours</span>
              {`Daily, ${formatTime(h.opens)}–${formatTime(h.closes)}`}
            </li>
            <li>
              <span>Weekday lunch</span>
              {`${lunchSpecial.time}`}
            </li>
            <li>
              <span>Book online</span>
              {`Parties of 1–${largePartySize - 1}`}
            </li>
          </ul>

          {widgetScript ? (
            <div class="widget">
              <div class="booking-widget" data-booking-widget={widgetScript}></div>
              <a class="alt" href={bookingUrl} target="_blank" rel="noopener" data-track="click_reserve" data-placement={`${id}_booking_link`}>
                Or book on {provider} ↗
              </a>
            </div>
          ) : (
            <div class="widget">
              <a class="btn" href={bookingUrl} target="_blank" rel="noopener" data-track="click_reserve" data-placement={`${id}_booking`}>
                Find a table
              </a>
            </div>
          )}

          <p class="large">
            <strong>Parties of {largePartySize} or more:</strong> email{' '}
            <a href={largeMail} data-track="click_email" data-placement={`${id}_large_party`}>{site.email}</a> or call{' '}
            <a href={`tel:${site.phoneE164}`} data-track="click_call" data-placement={`${id}_large_party`}>{site.phone}</a> and we'll
            plan the table, the cuts and the timing with you.
          </p>
        </div>
      ) : (
        <form
          class="form"
          data-enquiry
          data-endpoint={formEndpoint}
          data-subject={subject}
          method="post"
          action={formEndpoint}
          novalidate>
          <input type="hidden" name="_subject" value={subject} />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="row two">
            <div class="field">
              <label for={`${id}-name`}>Full name</label>
              <input id={`${id}-name`} name="name" autocomplete="name" placeholder="Your full name" required />
            </div>
            <div class="field">
              <label for={`${id}-email`}>Email address</label>
              <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="you@email.com" required />
            </div>
          </div>
          <div class="row three">
            <div class="field">
              <label for={`${id}-date`}>Date</label>
              <input id={`${id}-date`} name="date" type="date" required data-min-today />
            </div>
            <div class="field">
              <label for={`${id}-time`}>Time</label>
              <select id={`${id}-time`} name="time" required>
                {times.map((t) => <option selected={t === '6:30 PM'}>{t}</option>)}
              </select>
            </div>
            <div class="field">
              <label for={`${id}-guests`}>Guests</label>
              <select id={`${id}-guests`} name="guests" required>
                {guestOptions.map((g, i) => <option selected={i === 1}>{g}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for={`${id}-phone`}>Phone</label>
            <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" placeholder="(206) 555-0100" required />
          </div>
          <div class="field">
            <label for={`${id}-notes`}>Tell us about the event</label>
            <textarea id={`${id}-notes`} name="notes" rows="3" placeholder="Occasion, dine-in or catering, budget, anything we should know…"></textarea>
          </div>
          <div class="submit">
            <button class="btn" type="submit">Send enquiry</button>
            <p class="status" role="status" aria-live="polite" data-status></p>
          </div>
        </form>
      )
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-xl);
  }

  .intro {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .call a {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .booking {
    display: grid;
    gap: var(--space-l);
    align-content: start;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid var(--line);
    background: var(--ink-raised);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--line);
    list-style: none;
    font-size: 0.95rem;
    color: var(--cream);
  }

  .facts span {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .widget {
    display: grid;
    gap: 1rem;
    justify-items: start;
    min-height: 3.25rem;
  }

  .booking-widget {
    width: 224px;
    min-height: 301px;
    /* Matching the widget's light scheme keeps the browser from painting an opaque backdrop behind the iframe. */
    color-scheme: light;
  }

  .alt {
    font-size: 0.85rem;
    color: var(--cream-soft);
  }

  .alt:hover {
    color: var(--gold);
  }

  .large {
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--gold);
    background: var(--ink);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--cream-soft);
  }

  .large strong {
    font-weight: 500;
    color: var(--cream);
  }

  .large a {
    color: var(--gold);
  }

  .form {
    display: grid;
    gap: var(--space-l);
  }

  .row {
    display: grid;
    gap: var(--space-l);
  }

  .two {
    grid-template-columns: 1fr 1fr;
  }

  .three {
    grid-template-columns: 1.2fr 1fr 0.8fr;
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .status {
    font-size: 0.9rem;
    color: var(--cream-soft);
  }

  .status.is-error {
    color: #e48a7a;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .two,
    .three,
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const today = new Date();
  const iso = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  document.querySelectorAll<HTMLInputElement>('[data-min-today]').forEach((i) => (i.min = iso));

  const w = window as unknown as { gtag?: (...a: unknown[]) => void };

  // The OpenTable loader inserts its widget right before its own <script> element, so the
  // script is appended inside the placeholder after page load, once the panel is near the viewport.
  const widgets = document.querySelectorAll<HTMLElement>('[data-booking-widget]');
  if (widgets.length) {
    const load = (el: HTMLElement) => {
      if (el.dataset.loaded) return;
      el.dataset.loaded = 'true';
      const s = document.createElement('script');
      s.src = el.dataset.bookingWidget!;
      el.appendChild(s);
    };
    const start = () => {
      if (!('IntersectionObserver' in window)) return widgets.forEach(load);
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.unobserve(e.target);
            load(e.target as HTMLElement);
          }
        },
        { rootMargin: '600px 0px' },
      );
      widgets.forEach((el) => io.observe(el));
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }

  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.remove('is-error');
      if (!form.checkValidity()) {
        form.querySelector<HTMLElement>(':invalid')?.focus();
        status.classList.add('is-error');
        status.textContent = 'Please fill in your name, a valid email, phone and a date.';
        return;
      }

      const data = new FormData(form);
      w.gtag?.('event', 'submit_event_enquiry', { guests: data.get('guests') });

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        status.classList.add('is-error');
        status.textContent = 'Something went wrong. Please call us and we will take it from there.';
        return;
      }

      status.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const payload = (await res.json().catch(() => ({}))) as { success?: boolean | string; message?: string };
        // FormSubmit returns success:"false" on the first submit while it emails an
        // activation link. The enquiry is queued; treat that as sent so guests never
        // see a failure (or the inbox address).
        const activating = typeof payload.message === 'string' && /activat/i.test(payload.message);
        const ok =
          res.ok &&
          (activating ||
            payload.success === true ||
            payload.success === 'true' ||
            payload.success === undefined);
        if (!ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = "Thank you — we'll be in touch within one business day.";
      } catch {
        status.classList.add('is-error');
        status.textContent = 'Something went wrong. Please call us and we will take it from there.';
      }
    });
  });
</script>
