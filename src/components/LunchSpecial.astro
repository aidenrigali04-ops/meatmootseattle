---
import { lunchSpecial, formatPrice } from '@/data/menu';
---

<section class="lunch" aria-labelledby="lunch-title">
  <div class="container inner" data-reveal>
    <div class="label">
      <p class="eyebrow eyebrow--gold">{lunchSpecial.days} · {lunchSpecial.time}</p>
      <h2 id="lunch-title" class="h2">{lunchSpecial.title}</h2>
      <p class="served">{lunchSpecial.served}</p>
    </div>
    <p class="price">
      <span class="amount">{formatPrice(lunchSpecial.price)}</span>
      <span class="each">each</span>
    </p>
    <ul class="options">
      {
        lunchSpecial.options.map((o) => (
          <li>
            {o.href ? (
              <a href={o.href}>
                <span class="portion">{o.portion}</span>
                <span class="name">{o.name}</span>
              </a>
            ) : (
              <span>
                <span class="portion">{o.portion}</span>
                <span class="name">{o.name}</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lunch {
    border-block: 1px solid var(--line);
    background:
      radial-gradient(60% 140% at 50% 120%, rgb(var(--ember) / 0.14), transparent 70%),
      var(--ink-warm);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) auto minmax(0, 1.4fr);
    align-items: center;
    gap: var(--space-l);
    padding-block: var(--space-xl);
  }

  .label {
    display: grid;
    gap: 0.75rem;
  }

  .served {
    color: var(--cream-soft);
  }

  .price {
    display: grid;
    justify-items: center;
    padding-inline: var(--space-l);
    border-inline: 1px solid var(--line);
  }

  .amount {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 1;
    color: var(--gold);
  }

  .each {
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .options {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .options a,
  .options span {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }

  .options a:hover .name {
    color: var(--gold);
  }

  .portion {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--cream);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .price {
      justify-items: start;
      padding: var(--space-m) 0;
      border-inline: 0;
      border-block: 1px solid var(--line);
    }

    .options {
      grid-template-columns: 1fr;
    }
  }
</style>
