---
import { lunchSpecial, formatPrice } from '@/data/menu';
---

<section class="lunch" aria-labelledby="lunch-title">
  <div class="container inner" data-reveal>
    <div class="label">
      <p class="eyebrow eyebrow--gold">{lunchSpecial.days} · {lunchSpecial.time}</p>
      <h2 id="lunch-title" class="h2">{lunchSpecial.title}</h2>
    </div>
    <p class="price">
      <span class="portion">{lunchSpecial.portion}</span>
      <span class="amount">{formatPrice(lunchSpecial.price)}</span>
    </p>
    <div class="detail">
      <p>Choose <strong>{lunchSpecial.choices.join(' or ')}</strong>. {lunchSpecial.served}</p>
      <a class="link-arrow" href="/menu#lunch">Lunch details</a>
    </div>
  </div>
</section>

<style>
  .lunch {
    border-block: 1px solid var(--line);
    background:
      radial-gradient(60% 140% at 50% 120%, rgb(var(--ember) / 0.14), transparent 70%),
      var(--ink-warm);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-l);
    padding-block: var(--space-xl);
  }

  .label {
    display: grid;
    gap: 0.75rem;
  }

  .price {
    display: grid;
    justify-items: center;
    padding-inline: var(--space-l);
    border-inline: 1px solid var(--line);
  }

  .portion {
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .amount {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 1;
    color: var(--gold);
  }

  .detail {
    display: grid;
    gap: 1rem;
    justify-items: start;
    color: var(--cream-soft);
  }

  strong {
    color: var(--cream);
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .price {
      justify-items: start;
      padding: var(--space-m) 0;
      border-inline: 0;
      border-block: 1px solid var(--line);
    }
  }
</style>
