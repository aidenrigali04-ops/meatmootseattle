---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumbs?: Array<{ name: string; path: string }>;
}
const { eyebrow, title, intro, image, imageAlt = '', crumbs = [] } = Astro.props;
---

<section class:list={['page-header', { 'has-image': image }]}>
  {
    image && (
      <div class="media">
        <Image src={image} alt={imageAlt} widths={[480, 768, 1280, 1920]} sizes="100vw" quality={60} loading="eager" fetchpriority="high" />
      </div>
    )
  }
  <div class="container inner">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <p class="eyebrow eyebrow--gold eyebrow--rule">{eyebrow}</p>
    <h1 class="display" set:html={title} />
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-xl) var(--space-xl);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .page-header.has-image {
    min-height: min(88svh, 820px);
    display: grid;
    align-items: end;
    padding-top: calc(var(--header-h) + var(--space-xl));
  }

  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, var(--ink) 4%, rgb(11 11 12 / 0.55) 45%, rgb(11 11 12 / 0.35) 100%),
      linear-gradient(90deg, rgb(0 0 0 / 0.55), transparent 65%);
  }

  .inner {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  h1 {
    max-width: 16ch;
  }

  h1 :global(em) {
    color: var(--gold);
  }

  .intro {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--cream-soft);
  }
</style>
