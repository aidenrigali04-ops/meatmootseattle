---
import Base from '@/layouts/Base.astro';
import { pageMeta } from '@/data/seo';
---

<Base title={pageMeta.notFound.title} description={pageMeta.notFound.description} noindex>
  <section class="section">
    <div class="container lost">
      <p class="eyebrow eyebrow--gold">404</p>
      <h1 class="display">This cut is <em>off the menu.</em></h1>
      <p class="body-muted">The page you were looking for has moved or never existed. The brisket, however, is right where we left it.</p>
      <div class="ctas">
        <a class="btn" href="/menu">See the menu</a>
        <a class="link-arrow" href="/">Back home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    min-height: 60svh;
    align-content: center;
  }

  em {
    color: var(--gold);
  }

  .ctas {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
</style>
