---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Reserve from '@/components/Reserve.astro';
import { cuts, included, formatPrice, cutPriceLabel, type Cut } from '@/data/menu';
import { catering } from '@/data/catering';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';
import { cutMeta } from '@/data/seo';

export function getStaticPaths() {
  return cuts.map((cut, i) => ({
    params: { slug: cut.slug },
    props: { cut, next: cuts[(i + 1) % cuts.length] },
  }));
}

interface Props {
  cut: Cut;
  next: Cut;
}
const { cut, next } = Astro.props;
const meta = cutMeta(cut);
const path = `/menu/${cut.slug}`;
const crumbs = [
  { name: 'Menu', path: '/menu' },
  { name: cut.name, path },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'MenuItem',
  name: `Smoked ${cut.name}`,
  description: `${cut.summary} ${cut.serving} ${cut.story}`,
  url: new URL(path, site.url).toString(),
  suitableForDiet: 'https://schema.org/HalalDiet',
  offers:
    cut.soldBy === 'set'
      ? [
          {
            '@type': 'Offer',
            name: 'Regular',
            price: catering.lamb_shoulder.regular.price.toFixed(2),
            priceCurrency: 'USD',
            availability: 'https://schema.org/InStock',
            seller: { '@id': `${site.url}/#restaurant` },
          },
          {
            '@type': 'Offer',
            name: 'Large',
            price: catering.lamb_shoulder.large.price.toFixed(2),
            priceCurrency: 'USD',
            availability: 'https://schema.org/InStock',
            seller: { '@id': `${site.url}/#restaurant` },
          },
        ]
      : {
          '@type': 'Offer',
          price: cut.pricePerLb.toFixed(2),
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          priceSpecification: { '@type': 'UnitPriceSpecification', price: cut.pricePerLb.toFixed(2), priceCurrency: 'USD', unitCode: 'LBR', unitText: 'lb' },
          seller: { '@id': `${site.url}/#restaurant` },
        },
};

const ledger = [
  cut.soldBy === 'piece'
    ? `1 piece of halal ${cut.animal.toLowerCase()} ${cut.name.replace(/^(Lamb|Beef) /, '').toLowerCase()}`
    : cut.soldBy === 'set'
      ? `Halal ${cut.animal.toLowerCase()} ${cut.name.replace(/^(Lamb|Beef) /, '').toLowerCase()}, set price`
      : `Halal ${cut.animal.toLowerCase()} ${cut.name.replace(/^(Lamb|Beef) /, '').toLowerCase()}, sold by the pound`,
  'Unlimited house-made sauces',
  'Fresh salads & sides, with refills',
  `Garnish: ${included.garnish.slice(0, -1).join(', ').toLowerCase()} and ${included.garnish.at(-1)!.toLowerCase()}`,
  'Unlimited mineral water & soft drinks',
];
---

<Base
  title={meta.title}
  description={meta.description}
  schema={[productSchema, breadcrumbSchema(crumbs)]}
  overlayHeader
>
  <PageHeader
    eyebrow={`Slow-smoked halal ${cut.animal.toLowerCase()}`}
    title={cut.name}
    intro={cut.summary}
    image={cut.image}
    imageAlt={cut.imageAlt}
    crumbs={crumbs}
  >
    <p class="price-tag">
      {cut.soldBy === 'set' ? (
        cutPriceLabel(cut)
      ) : (
        <>
          {formatPrice(cut.pricePerLb)} <span>per lb</span>
        </>
      )}
    </p>
    <p class="serving-note">{cut.serving}</p>
  </PageHeader>

  <section class="section">
    <div class="container story">
      <h2 class="h2" data-reveal>The story</h2>
      <div data-reveal style="--reveal-i:1">
        <p class="lead-copy">{cut.story}</p>
        <p class="body-muted">{cut.texture}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="h3" data-reveal>On the board</h2>
        <ol class="ledger">
          {
            ledger.map((item, i) => (
              <li data-reveal style={`--reveal-i:${i}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {item}
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h2 class="h3" data-reveal>Method</h2>
        <p class="method" data-reveal style="--reveal-i:1">
          Halal-certified {cut.animal.toLowerCase()}, seasoned with our house blend and smoked in-house for up to {site.stats.smokeHours} hours, then weighed and carved to order at the counter.
        </p>
        <h2 class="h3 pair-title" data-reveal>Our carvers pair it with</h2>
        <ul class="pairs" data-reveal style="--reveal-i:1">
          {cut.pairsWith.map((p) => <li>{p}</li>)}
        </ul>
        <p class="muted" data-reveal>Plus any of our {included.sauces.length} sauces and {included.sides.length} sides.</p>
      </div>
    </div>
  </section>

  <section class="next">
    <a href={`/menu/${next.slug}`} class="container next-inner">
      <span class="eyebrow">Next cut</span>
      <span class="next-name">{next.name} <span aria-hidden="true">→</span></span>
      <Image src={next.image} alt="" width={320} height={220} class="next-img" />
    </a>
  </section>

  <Reserve />
</Base>

<style>
  .price-tag {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--gold);
  }

  .price-tag span {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .serving-note {
    margin-top: 0.5rem;
    max-width: 36ch;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--cream-soft);
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: var(--space-l);
  }

  .story > div {
    display: grid;
    gap: var(--space-m);
  }

  .lead-copy {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .ledger {
    list-style: none;
    margin-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .ledger li {
    display: flex;
    gap: 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--cream-soft);
  }

  .ledger span {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--muted);
    padding-top: 0.25rem;
  }

  .method {
    margin-top: var(--space-m);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
    color: var(--cream-soft);
  }

  .pair-title {
    margin-top: var(--space-l);
  }

  .pairs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block: var(--space-m);
  }

  .pairs li {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.85rem;
  }

  .muted {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .next {
    border-block: 1px solid var(--line);
  }

  .next-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-l);
    padding-block: var(--space-l);
    text-decoration: none;
  }

  .next-name {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 300;
    justify-self: end;
    transition: color 0.3s;
  }

  .next-inner:hover .next-name {
    color: var(--gold);
  }

  .next-img {
    width: 160px;
    height: 110px;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (max-width: 860px) {
    .story,
    .two-col {
      grid-template-columns: 1fr;
    }

    .next-inner {
      grid-template-columns: 1fr;
    }

    .next-name {
      justify-self: start;
    }

    .next-img {
      display: none;
    }
  }
</style>
