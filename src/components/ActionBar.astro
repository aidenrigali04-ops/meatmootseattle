---
import { site } from '@/data/site';
---

<nav class="action-bar" aria-label="Quick actions">
  <a href={`tel:${site.phoneE164}`} data-track="click_call" data-placement="action_bar">Call</a>
  <a href={site.links.directions} target="_blank" rel="noopener" data-track="click_directions" data-placement="action_bar">Directions</a>
  <a href="/#reserve" class="primary" data-track="click_reserve" data-placement="action_bar">Reserve</a>
</nav>

<style>
  .action-bar {
    display: none;
  }

  @media (max-width: 760px) {
    .action-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr 1.2fr;
      border-top: 1px solid var(--line-strong);
      background: rgb(11 11 12 / 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .action-bar a {
      display: grid;
      place-items: center;
      min-height: 56px;
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--cream);
    }

    .action-bar a + a {
      border-left: 1px solid var(--line);
    }

    .action-bar .primary {
      background: var(--gold);
      color: var(--ink);
    }

    :global(body) {
      padding-bottom: calc(56px + env(safe-area-inset-bottom));
    }
  }
</style>
