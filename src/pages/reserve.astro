---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Reserve from '@/components/Reserve.astro';
import VisitBlock from '@/components/VisitBlock.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { pageMeta } from '@/data/seo';

const crumbs = [{ name: 'Reserve', path: '/reserve' }];
---

<Base
  title={pageMeta.reserve.title}
  description={pageMeta.reserve.description}
  schema={[breadcrumbSchema(crumbs)]}
>
  <div class="container crumbs-wrap"><Breadcrumbs items={crumbs} /></div>
  <Reserve title="Book a table" headingLevel="h1" />
  <VisitBlock title="Find us in South Lake Union" />
</Base>

<style>
  .crumbs-wrap {
    padding-top: var(--space-l);
  }

  :global(.reserve) {
    padding-top: var(--space-l);
  }
</style>
