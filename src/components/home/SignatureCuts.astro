---
import { Image } from 'astro:assets';
import { cuts, cutPriceLabel } from '@/data/menu';

const featured = cuts.filter((c) => c.signature);
---

<section class="section cuts" id="signature-cuts" aria-labelledby="cuts-title">
  <div class="container">
    <header class="head">
      <div>
        <p class="eyebrow eyebrow--gold" data-reveal>Signature cuts</p>
        <h2 id="cuts-title" class="h2" data-reveal style="--reveal-i:1">Smoked for hours. <span class="italic">Carved in seconds.</span></h2>
      </div>
      <p class="body-muted" data-reveal style="--reveal-i:2">
        Every cut is halal and smoked low and slow over wood. Priced per pound, weighed in front of you, and served with unlimited house sauces and salads. Minimums and typical piece sizes are listed under each cut.
      </p>
    </header>

    <div class="layout" data-cuts>
      <ul class="list">
        {
          featured.map((c, i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <a href={`/menu/${c.slug}`} data-cut={i} class:list={[{ 'is-active': i === 0 }]}>
                <Image class="thumb" src={c.image} alt="" width={160} height={120} />
                <span class="name">{c.name}</span>
                <span class="meta">
                  <span>{c.animal}</span>
                  <span class="price">{cutPriceLabel(c)}</span>
                </span>
                <span class="serving">{c.serving}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="stage" aria-hidden="true">
        {
          featured.map((c, i) => (
            <figure class:list={['card', { 'is-active': i === 0 }]} data-card={i}>
              <Image src={c.image} alt="" widths={[480, 720, 960]} sizes="(max-width: 1100px) 50vw, 640px" />
              <figcaption>{c.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="foot" data-reveal>
      <a class="btn" href="/menu">See the full menu</a>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-l);
    align-items: end;
  }

  .head > div {
    display: grid;
    gap: var(--space-m);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: center;
    margin-top: var(--space-xl);
  }

  .list {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .list li {
    border-bottom: 1px solid var(--line);
  }

  .list a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 1.4rem 0;
    text-decoration: none;
    position: relative;
  }

  .serving {
    grid-column: 1 / -1;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .list a::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 0;
    background: var(--gold);
    transition: width 0.6s var(--ease-out);
  }

  .list a.is-active::before,
  .list a:hover::before {
    width: 100%;
  }

  .thumb {
    display: none;
  }

  .name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--cream-soft);
    transition: color 0.3s, transform 0.5s var(--ease-out);
  }

  .list a.is-active .name,
  .list a:hover .name {
    color: var(--cream);
    transform: translateX(0.4rem);
  }

  .meta {
    display: grid;
    justify-items: end;
    gap: 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .price {
    color: var(--gold);
    letter-spacing: 0.06em;
    font-size: 0.85rem;
  }

  .stage {
    position: relative;
    aspect-ratio: 4 / 3.4;
  }

  .card {
    position: absolute;
    inset: 6% 0 6% 14%;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink-raised);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9);
    opacity: 0;
    transform: translate(-12%, 4%) rotate(-3deg) scale(0.88);
    filter: brightness(0.5);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.9s var(--ease-out),
      filter 0.9s var(--ease-out);
  }

  .card.is-prev {
    opacity: 1;
    z-index: 1;
  }

  .card.is-active {
    opacity: 1;
    z-index: 2;
    transform: none;
    filter: none;
  }

  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 3rem 1.5rem 1.25rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.8));
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .foot {
    margin-top: var(--space-xl);
  }

  @media (max-width: 900px) {
    .head,
    .layout {
      grid-template-columns: 1fr;
    }

    .stage {
      display: none;
    }

    .list a {
      grid-template-columns: 88px 1fr;
      grid-template-rows: auto auto auto;
      align-items: center;
      column-gap: 1.25rem;
      padding: 1rem 0;
    }

    .thumb {
      display: block;
      grid-row: 1 / span 3;
      width: 88px;
      height: 66px;
      object-fit: cover;
      border-radius: var(--radius);
    }

    .serving {
      grid-column: 2;
    }

    .meta {
      grid-column: 2;
      grid-auto-flow: column;
      justify-content: start;
      gap: 1rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cuts]').forEach((root) => {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-cut]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    let active = 0;
    const show = (i: number) => {
      if (i === active) return;
      cards.forEach((c) => c.classList.remove('is-prev'));
      cards[active].classList.add('is-prev');
      cards[active].classList.remove('is-active');
      links[active].classList.remove('is-active');
      active = i;
      cards[i].classList.add('is-active');
      links[i].classList.add('is-active');
    };
    links.forEach((a, i) => {
      a.addEventListener('mouseenter', () => show(i));
      a.addEventListener('focus', () => show(i));
    });
    if (cards.length > 1) cards[1].classList.add('is-prev');
  });
</script>
