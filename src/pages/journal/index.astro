---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { breadcrumbSchema } from '@/lib/schema';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const crumbs = [{ name: 'Journal', path: '/journal' }];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Journal | Halal BBQ Guides & Stories | Meat Moot Seattle"
  description="Guides, stories and tips from Meat Moot Seattle — halal BBQ explained, how ordering by the pound works, and planning group meals in South Lake Union."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHeader eyebrow="Journal" title="Notes from <em>the smokehouse</em>" intro="Guides to halal barbecue, our cuts and getting the most from a meal at Meat Moot." crumbs={crumbs} />

  <section class="section">
    <div class="container">
      <ul class="posts">
        {
          posts.map((p, i) => (
            <li data-reveal style={`--reveal-i:${i % 3}`}>
              <a href={`/journal/${p.id}`}>
                <div class="img">
                  <Image src={p.data.cover} alt={p.data.coverAlt} widths={[400, 640, 900]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw" />
                </div>
                <time datetime={p.data.published.toISOString()}>{fmt(p.data.published)}</time>
                <h2 class="h3">{p.data.title}</h2>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .posts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-l);
  }

  a {
    display: grid;
    gap: 0.9rem;
    text-decoration: none;
  }

  .img {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  a:hover .img :global(img) {
    transform: scale(1.05);
  }

  a:hover h2 {
    color: var(--gold);
  }

  time {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  p {
    color: var(--cream-soft);
  }

  @media (max-width: 1000px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
